# Server
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://localhost:4173,https://*.vercel.app,https://*.ngrok-free.app,https://*.ngrok-free.dev,https://*.ngrok.app,https://*.ngrok.io

# Database - Using PostgreSQL in Docker
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=etunisia
DB_PASSWORD=etunisia_secret
DB_NAME=etunisia

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=dev-secret-jwt-key-2025-etunisia-platform
JWT_EXPIRES_IN=7d

# File Storage (MinIO S3-compatible)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=etunisia
S3_FORCE_PATH_STYLE=true

# Stripe (Optional - works without keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# OpenAI (Optional - works without key)
OPENAI_API_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM=noreply@etunisia.tn

# SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin
ADMIN_EMAIL=admin@etunisia.tn
ADMIN_PASSWORD=admin123



MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your-master-key
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key



