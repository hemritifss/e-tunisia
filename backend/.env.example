# ============================================
# e-Tunisia API Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Server
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# Options: sqlite | postgres | mysql
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=etunisia
DB_PASSWORD=etunisia_secret
DB_NAME=etunisia

# SQLite (used when DB_TYPE=sqlite)
SQLITE_DB_PATH=./etunisia.db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Google OAuth (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Web Push Notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@etunisia.com

# Meilisearch (Search engine — get from https://www.meilisearch.com/)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your-master-key

# File Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=etunisia
S3_FORCE_PATH_STYLE=true

# Stripe (International Payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe subscription webhook (optional — falls back to STRIPE_WEBHOOK_SECRET)
STRIPE_BILLING_WEBHOOK_SECRET=whsec_...

# Subscription Price IDs — generate with: npx ts-node backend/scripts/stripe-setup.ts
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_YEARLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...

# Billing currency + redirect URLs
# DISPLAY = what users see on the pricing page (TND).
# CHARGE  = what Stripe settles in. Set to TND only if your Stripe account allows it;
#           otherwise use EUR or USD (Stripe is not available to Tunisia-registered accounts).
BILLING_DISPLAY_CURRENCY=TND
BILLING_CHARGE_CURRENCY=TND
BILLING_SUCCESS_URL=http://localhost:5173/#/premium/welcome
BILLING_CANCEL_URL=http://localhost:5173/#/premium
# Public base URL of THIS backend (used as the Flouci success/fail return link).
PUBLIC_API_URL=http://localhost:3000

# Referral reward (give-X-get-X) in TND credit. Referee bonus is instant; the
# referrer's reward is held pending until the referee's first top-up (anti-farming).
REFERRAL_REWARD_TND=10
# Max referral rewards a single referrer can be paid (bounds abuse exposure).
REFERRAL_MAX_REWARDS=100

# Monthly streak-freeze allowance per plan (Pro retention perk; auto-saves a missed day).
STREAK_FREEZES_PREMIUM=1
STREAK_FREEZES_BUSINESS=3

# Local Tunisian Payment (Flouci / CIB)
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=

# ─── AI ───────────────────────────────────────────────────────────────────────
# The AI is HYBRID: a FREE model serves the frequent stuff (chat, translate,
# search, moderation, captions, tags) and Claude (optional, paid) serves only the
# heavy itinerary generation. With neither set, everything runs in mock mode.

# FREE provider — any OpenAI-compatible endpoint. Pick ONE:
#   Groq (free, fast, no card):  https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=llama-3.3-70b-versatile
#   Google Gemini (free tier):  https://aistudio.google.com/apikey
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     LLM_API_KEY=AIza...      LLM_MODEL=gemini-2.0-flash
#   OpenRouter free models:     https://openrouter.ai/keys
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_API_KEY=sk-or-...    LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Local Ollama (100% offline): LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.1
# Optional: a stronger free model just for itineraries → LLM_MODEL_PRO=...

# Claude (Anthropic) — OPTIONAL, used only for the PRO/itinerary tier when set.
# Needs account credits (console.anthropic.com → Billing). If unfunded, itineraries
# fall back to mock; the free provider above keeps everything else live.
# ANTHROPIC_API_KEY=sk-ant-...
#   ANTHROPIC_MODEL_PRO=claude-opus-4-8

# Daily AI messages for signed-out guests (logged-in users follow plan caps):
#   AI_GUEST_DAILY=3

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@etunisia.tn

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin
ADMIN_EMAIL=admin@etunisia.tn
ADMIN_PASSWORD=admin123
# Super-admins (comma-separated emails) — can grant/revoke the admin role and supervise
# the team. Works without a DB migration: listed emails are super-admin even if their
# DB role is just "admin".
SUPERADMIN_EMAILS=admin@etunisia.tn
