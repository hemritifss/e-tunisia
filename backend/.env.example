# ============================================
# e-Tunisia API Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Server
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# Options: sqlite | postgres | mysql
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=etunisia
DB_PASSWORD=etunisia_secret
DB_NAME=etunisia

# SQLite (used when DB_TYPE=sqlite)
SQLITE_DB_PATH=./etunisia.db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# File Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=etunisia
S3_FORCE_PATH_STYLE=true

# Stripe (International Payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Local Tunisian Payment (Flouci / CIB)
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=

# OpenAI (AI Travel Planner)
OPENAI_API_KEY=sk-...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@etunisia.tn

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin
ADMIN_EMAIL=admin@etunisia.tn
ADMIN_PASSWORD=admin123
